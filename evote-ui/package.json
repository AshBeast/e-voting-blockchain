{
  "name": "evote-ui",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:kiosk": "VITE_UI_MODE=kiosk vite",
    "dev:kiosk:local": "VITE_UI_MODE=kiosk vite",
    "dev:kiosk:sepolia": "VITE_UI_MODE=kiosk vite --mode sepolia",
    "build": "vite build",
    "build:kiosk": "VITE_UI_MODE=kiosk vite build",
    "build:kiosk:local": "VITE_UI_MODE=kiosk vite build",
    "build:kiosk:sepolia": "VITE_UI_MODE=kiosk vite build --mode sepolia",
    "relayer": "node relayer/server.cjs",
    "relayer:sepolia": "RELAYER_ENV_FILE=.env.sepolia node relayer/server.cjs",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "@semaphore-protocol/group": "^4.14.2",
    "@semaphore-protocol/identity": "^4.14.2",
    "@semaphore-protocol/proof": "^4.14.2",
    "cors": "^2.8.6",
    "ethers": "^6.15.0",
    "express": "^5.2.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.9.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "eslint": "^9.36.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.22",
    "globals": "^16.4.0",
    "vite": "^7.1.7"
  }
}
