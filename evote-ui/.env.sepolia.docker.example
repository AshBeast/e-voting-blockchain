# External UI port on the host machine
UI_PORT=8080
RELAYER_HOST_PORT=8787

# Frontend build-time values (Sepolia only)
VITE_RPC_URL=https://sepolia.infura.io/v3/YOUR_INFURA_KEY
VITE_CHAIN_ID=11155111
VITE_CONTRACT_ADDRESS=0xYOUR_DEFAULT_ELECTION_ADDRESS

# Relayer runtime values (Sepolia only)
RELAYER_PORT=8787
RELAYER_CHAIN_ID=11155111
RELAYER_RPC_URL=https://sepolia.infura.io/v3/YOUR_INFURA_KEY
RELAYER_PRIVATE_KEY=0xYOUR_SEPOLIA_RELAYER_PRIVATE_KEY
